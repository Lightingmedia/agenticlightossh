{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://cawwhnuezkrsexjvetjj.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "lightos-mcp",
      "version": "0.4.0",
      "title": "LightOS"
    },
    "tools": [
      {
        "name": "echo",
        "title": "Echo",
        "description": "Echo the input text back to the caller. Useful for verifying MCP connectivity.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "description": "Text to echo back."
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_agents",
        "title": "List LightRail agents",
        "description": "List the datacenter AI agents running in this LightOS deployment with their role and current status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "executing",
                "thinking",
                "idle",
                "error",
                "any"
              ],
              "description": "Filter by agent status. Defaults to 'any'."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_fabric_telemetry",
        "title": "Get photonic fabric telemetry",
        "description": "Return a snapshot of photonic-fabric telemetry (utilization, latency, thermal) for the requested window in seconds.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "windowSeconds": {
              "type": "integer",
              "description": "Sampling window in seconds. Typical range 10-300."
            }
          },
          "required": [
            "windowSeconds"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_runtime_capacity",
        "title": "Get accelerator capacity",
        "description": "Read verified CUDA, ROCm, TPU/XLA, and oneAPI/SYCL capacity from the Aurora control plane.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "runtime": {
              "type": "string",
              "enum": [
                "all",
                "cuda",
                "rocm",
                "tpu_xla",
                "oneapi_sycl"
              ],
              "description": "Runtime family to inspect."
            }
          },
          "required": [
            "runtime"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "validate_workload_intent",
        "title": "Validate workload intent",
        "description": "Validate a constrained accelerator workload intent against Aurora policy without executing it.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "workloadClass": {
              "type": "string",
              "enum": [
                "inference",
                "fine_tuning",
                "batch_training"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "runtime": {
              "type": "string",
              "enum": [
                "cuda",
                "rocm",
                "tpu_xla",
                "oneapi_sycl",
                "auto"
              ]
            },
            "objective": {
              "type": "string",
              "enum": [
                "lowest_latency",
                "lowest_cost",
                "maximum_throughput"
              ]
            },
            "acceleratorCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "minimumMemoryGiB": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048
            },
            "region": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "maxCostPerHourUsd": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000
            }
          },
          "required": [
            "workloadClass",
            "model",
            "runtime",
            "objective",
            "acceleratorCount",
            "minimumMemoryGiB",
            "region",
            "maxCostPerHourUsd"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "plan_deployment",
        "title": "Plan accelerator deployment",
        "description": "Ask Aurora for a policy-controlled placement, fabric route, cost estimate, and runtime plan; this tool never executes the plan.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "workloadClass": {
              "type": "string",
              "enum": [
                "inference",
                "fine_tuning",
                "batch_training"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "runtime": {
              "type": "string",
              "enum": [
                "cuda",
                "rocm",
                "tpu_xla",
                "oneapi_sycl",
                "auto"
              ]
            },
            "objective": {
              "type": "string",
              "enum": [
                "lowest_latency",
                "lowest_cost",
                "maximum_throughput"
              ]
            },
            "acceleratorCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "minimumMemoryGiB": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048
            },
            "region": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "availabilityTier": {
              "type": "string",
              "enum": [
                "standard",
                "high"
              ]
            },
            "dataLocality": {
              "type": "string",
              "maxLength": 160
            },
            "maxCostPerHourUsd": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000
            },
            "maxRuntimeMinutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 525600
            },
            "allowedProviders": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "maxItems": 30,
              "description": "Provider ids from list_compute_providers to consider; omit to let Aurora choose among the user's connected providers."
            }
          },
          "required": [
            "projectId",
            "workloadClass",
            "model",
            "runtime",
            "objective",
            "acceleratorCount",
            "minimumMemoryGiB",
            "region",
            "availabilityTier",
            "dataLocality",
            "maxCostPerHourUsd",
            "maxRuntimeMinutes"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_fabric_state",
        "title": "Get live fabric state",
        "description": "Read live Aurora topology, telemetry, or recent policy events from the privileged control plane.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "view": {
              "type": "string",
              "enum": [
                "topology",
                "telemetry",
                "events"
              ]
            },
            "windowSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          },
          "required": [
            "view",
            "windowSeconds"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_compute_providers",
        "title": "List compute providers",
        "description": "List the hyperscalers, NVIDIA services, GPU clouds and inference APIs LightOS can place workloads on, with accelerators, runtimes and capabilities. Use the returned ids in plan_deployment.allowedProviders. Never returns credentials.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "hyperscaler",
                "nvidia",
                "gpu_cloud",
                "inference_api",
                "self_managed",
                "any"
              ]
            },
            "runtime": {
              "type": "string",
              "enum": [
                "cuda",
                "rocm",
                "tpu_xla",
                "oneapi_sycl",
                "neuron",
                "asic",
                "any"
              ]
            },
            "accelerator": {
              "type": "string",
              "maxLength": 40,
              "description": "Substring match, e.g. 'H200' or 'TPU'"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
