# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google Gemini API Configuration
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Compute Providers: use the self-hosted backend (backend/providers) instead of the Supabase edge function.
# "/api/providers" works with the Vite dev proxy; in production use the absolute URL of your API.
# See docs/provider-backend.md. Leave unset to keep using the edge function.
# VITE_PROVIDERS_API_URL=/api/providers
