# Copy to .env on the GPU host:  cp .env.example .env
# Generate the token ON THE INSTANCE (never paste it into chat):
#   sed -i "s/^LIGHTOS_GATEWAY_TOKEN=.*/LIGHTOS_GATEWAY_TOKEN=$(openssl rand -hex 32)/" .env
LIGHTOS_GATEWAY_TOKEN=

# quick = random trycloudflare.com URL (changes every restart); named = stable hostname via token below.
# Add ,dcgm for DCGM telemetry and ,inference for the local model server, e.g. quick,dcgm,inference
COMPOSE_PROFILES=quick
CLOUDFLARE_TUNNEL_TOKEN=

# Optional
GATEWAY_NODE_NAME=
# Set when the dcgm profile is on:
# DCGM_EXPORTER_URL=http://dcgm-exporter:9400/metrics
# Set when the inference profile is on:
# VLLM_URL=http://vllm:8000
MODEL=Qwen/Qwen2.5-1.5B-Instruct
# Your real price per GPU-hour in USD (otherwise a list-price estimate is used for job cost)
GPU_HOUR_USD=
